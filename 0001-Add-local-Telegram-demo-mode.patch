+        isPinned: Bool = false,
+        isMuted: Bool = false
+    ) {
+        self.id = id
+        self.profile = profile
+        self.messages = messages
+        self.unreadCount = unreadCount
+        self.isPinned = isPinned
+        self.isMuted = isMuted
+    }
+
+    var lastMessage: DemoMessage? {
+        return self.messages.max(by: { $0.timestamp < $1.timestamp })
+    }
+}
